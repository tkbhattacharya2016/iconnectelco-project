{
  "_comment_1": "Copy this file to local.settings.json and fill in real values.",
  "_comment_2": "local.settings.json is gitignored. NEVER commit real credentials.",
  "_comment_3": "In production, Azure Key Vault supplies these values via App Setting references.",
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "FUNCTIONS_EXTENSION_VERSION": "~4",
    "AzureWebJobsFeatureFlags": "EnableWorkerIndexing",

    "PEGA_MODE": "live",
    "PEGA_BASE_URL": "https://your-tenant.pegacloud.net",
    "PEGA_CLIENT_ID": "PUT_REAL_CLIENT_ID_HERE",
    "PEGA_CLIENT_SECRET": "PUT_REAL_CLIENT_SECRET_HERE",
    "PEGA_TOKEN_CACHE_TTL_SECONDS": "3300",

    "CATALOG_STORAGE_ACCOUNT": "iconnectelcocatalog",
    "CATALOG_CONTAINER_NAME": "catalog",
    "CATALOG_CDN_BASE_URL": "https://cdn.iconnectelco.com"
  }
}
