  "field_reference": {
    "_note": "Field-by-field documentation. Required = must be present and non-null. Optional = may be null or absent.",

    "customer": {
      "firstName":   { "type": "string", "required": true,  "maxLength": 60, "example": "Sarah" },
      "lastName":    { "type": "string", "required": true,  "maxLength": 60, "example": "Chen" },
      "email":       { "type": "string", "required": true,  "format": "email", "example": "sarah.chen@example.com" },
      "phone":       { "type": "string", "required": true,  "format": "US-style", "example": "(512) 555-0142" },
      "dob":         { "type": "string", "required": false, "format": "YYYY-MM-DD", "example": "1992-04-18", "note": "Required for new accounts; null for existing customers" },
      "accountType": { "type": "string", "required": true,  "enum": ["new", "existing"] }
    },

    "shipping_and_billing": {
      "street":  { "type": "string", "required": true,  "maxLength": 120 },
      "city":    { "type": "string", "required": true,  "maxLength": 60 },
      "state":   { "type": "string", "required": true,  "format": "US 2-letter code", "example": "TX" },
      "zip":     { "type": "string", "required": true,  "format": "5 or 9 digits", "example": "78704" },
      "country": { "type": "string", "required": true,  "default": "US" }
    },

    "payment_card": {
      "method":      { "type": "string", "required": true,  "enum": ["card", "financing"] },
      "brand":       { "type": "string", "required": true,  "enum": ["Visa", "Mastercard", "Amex", "Discover", "Card"] },
      "last4":       { "type": "string", "required": true,  "format": "4 digits", "note": "Full PAN never transmitted" },
      "expiry":      { "type": "string", "required": true,  "format": "MM/YY" },
      "nameOnCard":  { "type": "string", "required": false, "note": "Card method only" }
    },

    "payment_financing_extras": {
      "financingMonths": { "type": "integer", "required": true, "enum": [24, 36], "note": "Required when method=financing" }
    },

    "items": {
      "id":      { "type": "string",  "required": true,  "note": "SKU identifier matching the catalog" },
      "type":    { "type": "string",  "required": true,  "enum": ["device", "plan", "accessory", "bundle"] },
      "brand":   { "type": "string",  "required": false, "note": "null for plans and bundles (ConnecTelco-internal)" },
      "name":    { "type": "string",  "required": true },
      "price":   { "type": "number",  "required": true,  "format": "decimal, 2 places" },
      "storage": { "type": "integer", "required": false, "note": "GB; null for non-device items" }
    },

    "totals": {
      "subtotal":         { "type": "number", "required": true },
      "tax":              { "type": "number", "required": true },
      "shipping":         { "type": "number", "required": true, "note": "0 if subtotal >= 100" },
      "deviceTotal":      { "type": "number", "required": true, "note": "Used to calculate financing split" },
      "monthlyFinancing": { "type": "number", "required": true, "note": "0 if no financing" },
      "dueToday":         { "type": "number", "required": true, "note": "What gets charged at order time" },
      "total":            { "type": "number", "required": true, "note": "Subtotal + tax + shipping (excluding financing)" }
    },

    "envelope": {
      "channel":     { "type": "string", "required": true, "enum": ["web-portal", "mobile-app", "csr-desktop", "ivr"] },
      "submittedAt": { "type": "string", "required": true, "format": "ISO 8601 UTC" }
    }
  },

  "error_responses": {
    "_note": "What the browser will show in the success screen if the Pega call fails.",
    "validation_failure": {
      "httpStatus": 400,
      "body": { "error": "validation_failed", "fields": ["customer.email"], "recoverable": false }
    },
    "credit_check_declined": {
      "httpStatus": 200,
      "body": { "orderId": "ORD-PENDING", "pegaCaseID": "CT-ORDER C-482195", "status": "CreditCheckDeclined", "recoverable": true, "fallbackMessage": "We can't approve financing right now. Please pay in full or contact support." }
    },
    "pega_unavailable": {
      "httpStatus": 502,
      "body": { "error": "Upstream Pega temporarily unavailable", "recoverable": true, "retryAfterSeconds": 30 }
    },
    "demo_mode_8pct_failure": {
      "_note": "Demo only — the in-browser fetch shim simulates this in 8% of requests for the autonomous-recovery story.",
      "httpStatus": 502,
      "body": { "error": "Upstream Pega temporarily unavailable", "recoverable": true }
    }
  }
}
