{
  "_documentation": {
    "title": "iConnecTelco — Place Order payload to Pega REST API",
    "version": "1.0.0",
    "lastUpdated": "2026-04-24",
    "description": "This file documents the exact JSON shape that gets POSTed when a customer clicks 'Place order' on the checkout review screen. Two complete examples are provided — one for a card-paid order and one for a 0% APR financed order. The Azure Function broker wraps this in Pega's case-creation envelope before forwarding to the Pega Platform REST API v2.",
    "flow": [
      "1. Browser collects customer details across 3 checkout steps (contact/address, payment, review).",
      "2. On 'Place order' click, browser POSTs the 'browserPayload' shape below to /api/pega-order (an Azure Function endpoint).",
      "3. The Azure Function authenticates with Pega via OAuth 2.0 client_credentials, then wraps the browserPayload inside Pega's case-creation envelope (see 'pegaCaseEnvelope' below).",
      "4. The Function POSTs to https://{pega-base-url}/prweb/api/application/v2/cases.",
      "5. Pega returns a caseID; Function returns it to the browser as { orderId, status, estimatedDelivery }."
    ],
    "endpoints": {
      "browser_to_function": "POST /api/pega-order",
      "function_to_pega": "POST {PEGA_BASE_URL}/prweb/api/application/v2/cases",
      "pega_oauth": "POST {PEGA_BASE_URL}/prweb/PRRestService/oauth2/v1/token"
    },
    "authentication": "OAuth 2.0 client_credentials grant. The Azure Function holds client_id and client_secret in Azure Key Vault. Tokens are cached in memory until ~30s before expiry. The browser never sees the Pega credentials.",
    "pii_handling": "Credit card number, CVV, and password are never sent to Pega. Only the card brand and last 4 digits are persisted. Password is routed separately to Azure AD B2C for hashing before account creation."
  },

